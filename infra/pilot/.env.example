# auscii-deploy — configuration du pilote (/opt/auscii-deploy/.env, chmod 600).
# install.sh écrit ce fichier avec des secrets tirés au hasard. Une copie
# complète du .env va dans le coffre de mots de passe de l'agence : sans
# APP_ENCRYPTION_KEY, les clés des intégrations et la clé SSH du pilote sont
# irrécupérables (voir docs/runbook.md, « Reconstruire le pilote »).
#
# Syntaxe : NOM='valeur'. Entre apostrophes, Compose ne remplace pas les $.

# --- Identité publique ---
# Nom d'hôte de l'outil, enregistrement A vers ce serveur.
PILOT_HOST='deploy.auscii.site'
# Nom d'hôte des aperçus des versions (étape 3), enregistrement A vers ce
# serveur. Obligatoirement sur un domaine enregistrable DIFFÉRENT de celui de
# l'outil (ex. auscii-preview.site), pour que le contenu des zips clients ne
# partage jamais le « site » de l'outil (cookies, SameSite).
PREVIEW_APP_HOST='apercu.auscii-preview.site'
# Adresse utilisée par Let's Encrypt pour les avis d'expiration.
ACME_EMAIL='contact@auscii.com'

# --- Images (GitHub Container Registry) ---
# Organisation GitHub qui publie les images (en minuscules) :
# ghcr.io/<GHCR_OWNER>/auscii-deploy-{app,worker,backup}.
GHCR_OWNER='auscii'
# SHA court (7 caractères) publié par la CI. Jamais "latest" : update.sh
# garde ainsi un tag précis pour revenir en arrière.
IMAGE_TAG=''
# Tag précédent, écrit par update.sh après une mise à jour réussie.
PREVIOUS_IMAGE_TAG=''

# --- Secrets (openssl rand -hex 32 ; POSTGRES_PASSWORD : openssl rand -hex 24) ---
POSTGRES_PASSWORD=''
BETTER_AUTH_SECRET=''
APP_ENCRYPTION_KEY=''

# --- Mode démo (laisser false sur le pilote) ---
DEMO_MODE='false'

# --- Sauvegardes ---
# Heure de la sauvegarde nocturne, heure de Paris (le conteneur tourne en
# TZ=Europe/Paris), 0-23.
BACKUP_HOUR='3'
# Surveillance externe facultative (healthchecks.io ou équivalent) : pingée
# après chaque sauvegarde réussie, <url>/fail en cas d'échec.
BACKUP_PING_URL=''
# Clé publique age (age1…) qui chiffre les sauvegardes envoyées sur Object
# Storage. La clé privée correspondante est dans le coffre, jamais ici.
BACKUP_AGE_RECIPIENT=''
# Scaleway Object Storage. Laisser S3_BUCKET vide pour ne garder que les
# sauvegardes locales.
S3_BUCKET=''
S3_ENDPOINT='https://s3.fr-par.scw.cloud'
S3_REGION='fr-par'
S3_ACCESS_KEY=''
S3_SECRET_KEY=''
