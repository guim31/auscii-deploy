# auscii-deploy — configuration du pilote. Copier en .env (chmod 600, root uniquement).
# install.sh génère ce fichier avec des secrets tirés au hasard.

# --- Identité publique ---
# Nom d'hôte du pilote, doit pointer (enregistrement A) vers ce serveur.
PILOT_HOST=deploy.auscii.site
# Adresse utilisée par Let's Encrypt pour les avis d'expiration.
ACME_EMAIL=contact@auscii.com

# --- Images (GitHub Container Registry) ---
GHCR_OWNER=guim31
# Tag à exécuter : un SHA court publié par la CI, ou "latest".
IMAGE_TAG=latest

# --- Secrets (openssl rand -hex 32) ---
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
APP_ENCRYPTION_KEY=

# --- Premier compte administrateur (créé au premier démarrage seulement) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Mode démo (laisser false sur le pilote) ---
DEMO_MODE=false

# --- Sauvegardes vers Scaleway Object Storage ---
# Laisser S3_BUCKET vide pour ne conserver que les sauvegardes locales.
S3_BUCKET=
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Heure de la sauvegarde nocturne (heure du serveur, 0-23).
BACKUP_HOUR=3
